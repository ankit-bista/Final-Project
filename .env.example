# ==========================================
# Blockchain Drive - Environment Variables
# ==========================================

# Two different services (do not use one port for both):
#   - Node/Express API  → default PORT=5000 (login, MySQL, proxies uploads to IPFS)
#   - IPFS Kubo daemon  → often API+gateway on 5002 (your setup)
PORT=5000

# Session Secret (Change this in production)
SESSION_SECRET=my-super-secret-session-key

# Database Credentials
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ipfs_app

# IPFS Node URL (Defaults to local Kubo node)
# If your `ipfs config show` says Addresses.API is on port 5002, use 5002 here.
IPFS_API_URL=http://127.0.0.1:5002/api/v0

# IPFS HTTP gateway used for viewing files from expiring links
# Your working example: http://127.0.0.1:5002/ipfs/<cid>
IPFS_GATEWAY_URL=http://127.0.0.1:5002

# Where Next.js proxies /auth, /files, /upload, … (must be Node, NOT IPFS)
BACKEND_URL=http://127.0.0.1:5000

# Frontend API base URL — leave unset so the browser calls the Next.js app origin
# and rewrites proxy to Express (session cookies work). Only set for a separate API host.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# ==========================================
# BLOCKCHAIN & METAMASK CONFIGURATION
# ==========================================

# 1. RPC URL (e.g. Polygon Mumbai or Infura)
RPC_URL=https://rpc-mumbai.maticvigil.com

# 2. Smart Contract Addresses (Update after deployment)
STORAGE_ALLOC_CONTRACT=0x0000000000000000000000000000000000000001
DRIVE_V2_CONTRACT=0x0000000000000000000000000000000000000002

# 3. ADMIN_PRIVATE_KEY
# ------------------------------------------
# To connect the backend to your MetaMask wallet for contract interactions:
#   1. Open MetaMask extension.
#   2. Click the three dots (Account Options) next to your account name.
#   3. Click "Account Details".
#   4. Click "Show Private Key" and enter your MetaMask password.
#   5. Copy the private key and paste it below.
#   WARNING: NEVER SHARE THIS KEY. Do NOT commit this file to GitHub!
# ------------------------------------------
ADMIN_PRIVATE_KEY=your_metamask_private_key_here

# If true, uploads will be blocked when on-chain quota check fails.
# Default is false to keep prototype uploads working even if quota isn't allocated yet.
ENFORCE_QUOTA_ON_UPLOAD=false

# If true, the backend will deny access/link creation when the smart contract
# permission check fails (hybrid best practice). If false, the app will fall
# back to DB RBAC when contract checks are unavailable.
ENFORCE_CONTRACT_PERMISSIONS=false

# If true, DB file_shares are written only if the smart-contract shareFile call succeeds.
# This makes the hybrid model consistent (no best-effort DB-only shares).
ENFORCE_CONTRACT_SHARING=false
